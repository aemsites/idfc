  {
    "id": "page-metadata",
    "fields": [
      {
        "component": "boolean",
        "name": "breadcrumbs",
        "label": "Show Breadcrumbs",
        "description": "Show the breadcrumbs trail above page content"
      },
      {
        "component": "text",
        "name": "breadcrumbsTitle",
        "label": "Breadcrumbs Title",
        "description": "Title for breadcrumb entry",
        "condition": {
          "==": [
            {
              "var": "breadcrumbs"
            },
            true
          ]
        }
      },
      {
        "component": "text",
        "name": "jcr:title",
        "valueType": "string",
        "label": "Title"
      },
      {
