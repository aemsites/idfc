{
  "definitions": [
    {
      "title": "Button",
      "id": "button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/button/v1/button",
            "template": {
              "model": "button"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "button",
      "fields": [
        {
          "component": "aem-content",
          "name": "link",
          "label": "Button Link",
          "description": "The URL the button links to"
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Button Text",
          "description": "The text displayed on the button"
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Alt Text / Title",
          "description": "Accessibility text shown on hover"
        },
        {
          "component": "select",
          "name": "linkType",
          "label": "Type",
          "options": [
            {
              "name": "default",
              "value": ""
            },
            {
              "name": "primary",
              "value": "primary"
            },
            {
              "name": "secondary",
              "value": "secondary"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Button Color",
          "description": "Select button color (Primary buttons only)",
          "condition": {
            "==": [
              {
                "var": "linkType"
              },
              "primary"
            ]
          },
          "options": [
            {
              "name": "None",
              "value": ""
            },
            {
              "name": "Red (Brand)",
              "value": "btn-red"
            },
            {
              "name": "Transparent",
              "value": "btn-transparent"
            },
            {
              "name": "White (Outline)",
              "value": "btn-white"
            }
          ]
        }
      ]
    }
  ]
}
